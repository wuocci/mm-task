{
  "name": "mm-task",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names storage,api,web --prefix-colors gray,blue,magenta \"npm:dev:storage\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:storage": "azurite --silent --location .azurite",
    "dev:web": "npm run dev -w @mm/web",
    "dev:api": "npm run start -w @mm/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
